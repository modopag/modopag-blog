# Cloudflare Pages — headers HTTP customizados.
# Sintaxe: caminho seguido de um header por linha, indentado com 2 espaços.
# Matches mais específicos sobrescrevem matches genéricos.

# Imagens proxiadas do Supabase Storage → cache imutável (têm hash no path)
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Assets do Astro (JS/CSS com hash) → cache imutável de 1 ano
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Headers de segurança aplicados a todas as respostas
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
