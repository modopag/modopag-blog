---
import type { Post } from '@/lib/types';
import { truncate } from '@/utils/helpers';

interface Props {
  post: Post;
  variant?: 'default' | 'featured';
}

const { post, variant = 'default' } = Astro.props;
const categorySlug = post.category?.slug || 'artigos';
const categoryName = post.category?.name || 'Artigos';
const categoryColor = post.category?.color || '#1a1a2e';
const hasImage = !!post.featured_image;

// Meta: data publicada e tempo de leitura — formato editorial mono uppercase
const publishedDate = new Date(post.published_at ?? post.created_at);
const dateLabel = publishedDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
const readingLabel = post.reading_time ? `${post.reading_time} min` : '';
---

<article class:list={['post-card group h-full', variant === 'featured' && 'post-card--featured']}>
  <a
    href={`/${categorySlug}/${post.slug}/`}
    data-astro-prefetch="viewport"
    class="post-card__link"
    aria-label={`Ler: ${post.title}`}
  >
    <!-- Image / Placeholder -->
    <div class="post-card__image">
      {hasImage ? (
        <img
          src={post.featured_image}
          alt={post.featured_image_alt || post.title}
          width="640"
          height="360"
          class="post-card__img"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class="post-card__placeholder"
          style={`--cat-color: ${categoryColor};`}
          aria-hidden="true"
        >
          <span class="post-card__placeholder-mark">/</span>
        </div>
      )}

      <!-- Category pill flutuante com glass effect -->
      <span class="post-card__category">{categoryName}</span>
    </div>

    <!-- Body -->
    <div class="post-card__body">
      <h3 class="post-card__title">{post.title}</h3>

      {post.description && (
        <p class="post-card__description">{truncate(post.description, 140)}</p>
      )}

      <!-- Meta footer editorial: data · tempo -->
      <div class="post-card__meta">
        <time datetime={publishedDate.toISOString()}>{dateLabel}</time>
        {readingLabel && (
          <>
            <span class="post-card__sep" aria-hidden="true">·</span>
            <span>{readingLabel}</span>
          </>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: theme('colors.cream.paper');
    border: 1px solid theme('colors.line.DEFAULT');
    border-radius: 1.25rem;
    overflow: hidden;
    transition:
      transform 320ms var(--ease),
      border-color 220ms var(--ease),
      box-shadow 320ms var(--ease);
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: theme('colors.onyx.DEFAULT');
    box-shadow: var(--shadow-md);
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: inherit;
    text-decoration: none;
  }

  /* Image area */
  .post-card__image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: theme('colors.cream.200');
  }

  .post-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 480ms var(--ease);
  }

  .post-card:hover .post-card__img {
    transform: scale(1.04);
  }

  /* Placeholder elegante quando não tem imagem — gradient da cor da categoria */
  .post-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cat-color) 24%, var(--color-cream-2)) 0%,
      var(--color-cream-2) 100%
    );
  }

  .post-card__placeholder-mark {
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--cat-color);
    opacity: 0.35;
    letter-spacing: -0.05em;
  }

  /* Category pill com glass effect */
  .post-card__category {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: 'JetBrains Mono Variable', ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(250, 246, 236, 0.92);
    backdrop-filter: blur(8px) saturate(140%);
    -webkit-backdrop-filter: blur(8px) saturate(140%);
    padding: 5px 10px;
    border-radius: 999px;
    color: theme('colors.onyx.DEFAULT');
    font-weight: 500;
    box-shadow: var(--shadow-sm);
  }

  /* Body */
  .post-card__body {
    padding: 1.375rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0 0 0.625rem;
    color: theme('colors.ink.DEFAULT');
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 200ms var(--ease);
  }

  .post-card:hover .post-card__title {
    color: theme('colors.gold.deep');
  }

  .post-card__description {
    font-size: 0.875rem;
    line-height: 1.55;
    color: theme('colors.ink.muted');
    margin: 0 0 auto;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Meta footer mono uppercase */
  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid theme('colors.line.DEFAULT');
    font-family: 'JetBrains Mono Variable', ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: theme('colors.ink.muted');
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-card__sep {
    color: theme('colors.line.strong');
  }

  /* ───────── FEATURED variant — pra hero/destaque ───────── */
  .post-card--featured .post-card__image {
    aspect-ratio: 16 / 10;
  }

  .post-card--featured .post-card__title {
    font-size: 1.5rem;
    line-height: 1.2;
    -webkit-line-clamp: 3;
  }

  .post-card--featured .post-card__description {
    font-size: 0.9375rem;
    -webkit-line-clamp: 3;
  }

  .post-card--featured .post-card__body {
    padding: 1.75rem;
  }

  @media (min-width: 1024px) {
    .post-card--featured .post-card__title {
      font-size: 1.75rem;
    }
  }
</style>
