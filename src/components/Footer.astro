---
/**
 * Footer do blog — mesma identidade do footer do site modopag.com.br
 * (referência: site-modopag/src/components/sections/Footer.astro).
 * Inclui o CTA hero pré-footer ("Pronto pra vender...") no topo,
 * substituindo o antigo CTABannerBottom.
 */
const currentYear = new Date().getFullYear();

const SITE_URL = 'https://modopag.com.br';

// UTM dos links do grid (padrão histórico do footer do blog)
const utmFooter = 'utm_source=blog&utm_medium=footer&utm_campaign=blog_modopag';
// UTM do CTA hero (ciclo 3)
const utmCta = 'utm_source=blog&utm_medium=cta_footer';

/** Monta URL absoluta pro site com UTM (respeitando âncoras). */
function siteUrl(path: string): string {
  if (path.startsWith('#')) return `${SITE_URL}/?${utmFooter}${path}`;
  return `${SITE_URL}${path}?${utmFooter}`;
}

const appStoreHref = 'https://apps.apple.com/br/app/modopag/id6755493173';
const googlePlayHref =
  'https://play.google.com/store/apps/details?id=app.modopag.vitum6mp&hl=pt_BR';

interface FooterLink {
  label: string;
  href: string;
  title?: string;
  external?: boolean;
}

const productLinks: FooterLink[] = [
  { label: 'Maquininha de cartão', href: siteUrl('/maquininhas/'), title: 'Maquininha de cartão — compare os modelos modoPAG' },
  { label: 'Modos de vender', href: siteUrl('#modos-de-vender') },
  { label: 'Planos e taxas', href: siteUrl('/planos-e-taxas/') },
  { label: 'Bandeiras aceitas', href: siteUrl('#bandeiras') },
  { label: 'Simulador de taxas', href: siteUrl('#simulador') },
  { label: 'Calculadora de repasse', href: siteUrl('/calculadora-de-repasse/') },
];

const solutionLinks: FooterLink[] = [
  { label: 'Link de pagamento (modoLINK)', href: siteUrl('/modolink/'), title: 'modoLINK — link de pagamento da modoPAG, venda em até 18x' },
  { label: 'Maquininha no celular (modo TAP)', href: siteUrl('/modo-tap/'), title: 'modo TAP — aceite cartão direto no celular' },
  { label: 'Voucher: VR e VA (modo VOUCHER)', href: siteUrl('/maquina-de-cartao-com-voucher/'), title: 'modo VOUCHER — máquina de cartão que aceita voucher, VR e VA' },
  { label: 'TEF e Pin Pad (modo TEF)', href: siteUrl('/maquina-de-cartao-tef/'), title: 'modo TEF — Pin Pad integrado à automação comercial, sem mensalidade' },
  { label: 'Recarga de celular', href: siteUrl('/maquina-de-recarga-de-celular/'), title: 'Venda recarga de celular na maquininha modoPAG com 0% de taxa e comissão' },
  { label: 'Recibo digital (modo RECIBO)', href: siteUrl('/modo-recibo/'), title: 'modoRECIBO — recibo digital com assinatura jurídica, proteção contra chargeback' },
  { label: 'Sistema pra barbearia (modo GESTOR)', href: siteUrl('/modo-gestor/'), title: 'Maquininha de cartão para barbearia · Plano Barber modoPAG' },
];

// Ajuda: links institucionais do site + links próprios do blog
const helpLinks: FooterLink[] = [
  { label: 'Sobre a modoPAG', href: siteUrl('/sobre-nos/') },
  { label: 'Indique e Ganhe', href: siteUrl('/indique-e-ganhe/') },
  { label: 'Ferramentas grátis', href: '/ferramentas/', title: 'Ferramentas grátis do blog modoPAG' },
  { label: 'Calculadoras', href: '/calculadoras/', title: 'Calculadoras grátis do blog modoPAG' },
  { label: 'Central de ajuda', href: 'https://ajuda.modopag.com.br', external: true },
  { label: 'Ouvidoria e SAC', href: siteUrl('/ouvidoria/') },
  { label: 'Fale com a gente', href: 'https://wa.me/5571981470573', external: true },
];

const legalLinks: FooterLink[] = [
  { label: 'Termos de uso', href: `${SITE_URL}/termos-de-uso-e-condicoes-de-uso/` },
  { label: 'Política de devolução', href: `${SITE_URL}/politica-de-devolucao/` },
  { label: 'Política de privacidade', href: `${SITE_URL}/politicas-de-privacidade/` },
  { label: 'Termo de consentimento', href: `${SITE_URL}/termo-de-consentimento/` },
  { label: 'Programa de afiliados', href: `${SITE_URL}/contrato-adesao-programa-afiliados/` },
];

const social = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/modopag/',
    path: 'M12 2.163c3.204 0 3.584.012 4.849.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.849.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/profile.php?id=61565893285984',
    path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@modopag',
    path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    name: 'X',
    href: 'https://x.com/modopag',
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    name: 'TikTok',
    href: 'https://www.tiktok.com/@modopag',
    path: 'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z',
  },
];
---

<footer class="relative overflow-hidden bg-modopag-text text-modopag-bg">
  <!-- Ambient glow amber no topo -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[520px] opacity-70"
    style="background: radial-gradient(900px 360px at 50% 0%, rgba(255, 215, 0, 0.18), transparent 70%)"
    aria-hidden="true"
  ></div>

  <!-- Dot pattern sutil -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: radial-gradient(rgba(255,255,255,1) 1px, transparent 1px); background-size: 22px 22px;"
    aria-hidden="true"
  ></div>

  <!-- ===== CTA HERO (pré-footer) ===== -->
  <div class="relative mx-auto max-w-7xl px-6 pb-16 pt-20 lg:pb-24 lg:pt-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <div class="text-center lg:text-left">
        <h2
          class="text-balance font-semibold tracking-tight text-modopag-bg"
          style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; letter-spacing: -0.03em"
        >
          Pronto pra vender com a
          <span class="text-modopag-amber">menor taxa do Brasil</span>?
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-[15px] leading-relaxed text-modopag-bg/70 sm:text-base lg:mx-0">
          Simule sua taxa em segundos ou fale com a nossa equipe no WhatsApp.
          Sem compromisso, sem letra miúda.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a
            href={`${SITE_URL}/maquininhas/?${utmCta}`}
            data-cta="footer-comprar"
            data-no-instant
            class="inline-flex items-center gap-2 rounded-full bg-modopag-amber px-7 py-3.5 text-[15px] font-semibold text-modopag-text shadow-[0_16px_40px_-12px_rgba(255,215,0,0.45)] transition hover:-translate-y-0.5 hover:bg-modopag-amber-deep hover:text-white hover:shadow-[0_20px_48px_-12px_rgba(196,138,0,0.55)]"
          >
            Pedir minha maquininha
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a
            href="https://wa.me/5571981470573"
            target="_blank"
            rel="noopener noreferrer"
            data-cta="footer-whatsapp"
            class="inline-flex items-center gap-2 rounded-full border border-modopag-bg/25 px-6 py-3.5 text-[15px] font-semibold text-modopag-bg transition hover:-translate-y-0.5 hover:border-modopag-amber hover:bg-modopag-amber/10 hover:text-modopag-amber"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            Falar no WhatsApp
          </a>
        </div>
      </div>

      <!-- Maquininha Smart-5 -->
      <div class="relative order-first lg:order-last">
        <div
          class="pointer-events-none absolute inset-0 -z-10 mx-auto h-[80%] w-[70%] rounded-full blur-3xl"
          style="background: radial-gradient(circle, rgba(255,215,0,0.25), transparent 70%); top: 10%;"
          aria-hidden="true"
        ></div>
        <img
          src="/images/cta-smart-5.png"
          alt="Maquininha modoSMART"
          width="360"
          height="480"
          loading="lazy"
          decoding="async"
          class="mx-auto w-full max-w-[260px] drop-shadow-[0_24px_48px_rgba(0,0,0,0.45)] sm:max-w-[300px] lg:max-w-[360px]"
        />
        <p class="mt-3 text-center text-[10px] uppercase tracking-[0.18em] text-modopag-bg/40">
          Imagem ilustrativa
        </p>
      </div>
    </div>
  </div>

  <!-- Divider CTA → links -->
  <div class="relative mx-auto max-w-7xl px-6">
    <div class="h-px w-full bg-modopag-bg/10"></div>
  </div>

  <!-- ===== GRID DE LINKS ===== -->
  <div class="relative mx-auto max-w-7xl px-6 py-14 lg:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.9fr_1.1fr_0.9fr_0.9fr] lg:gap-10">
      <!-- Brand column -->
      <div>
        <a href="/" aria-label="Blog modoPAG — voltar para a home" class="mb-5 inline-flex transition hover:opacity-90">
          <img
            src="/images/brand/modopag-logo-branca.svg"
            alt="modoPAG"
            width="140"
            height="36"
            class="h-9 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="max-w-xs text-sm leading-relaxed text-modopag-bg/70">
          Maquininha com as menores taxas do Brasil. Sem letra miúda, sem
          pegadinha — só o melhor pro seu negócio.
        </p>

        <div class="mt-7">
          <p class="mb-3 text-[11px] uppercase tracking-[0.2em] text-modopag-amber">
            Baixe o app
          </p>
          <div class="flex flex-wrap gap-2">
            <a
              href={appStoreHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Baixar na App Store"
              class="inline-block transition hover:-translate-y-0.5"
            >
              <img
                src="/images/footer/app-store.svg"
                alt="App Store"
                width="135"
                height="40"
                class="h-10 w-auto app-badge"
                loading="lazy"
                decoding="async"
              />
            </a>
            <a
              href={googlePlayHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Baixar no Google Play"
              class="inline-block transition hover:-translate-y-0.5"
            >
              <img
                src="/images/footer/google-play.svg"
                alt="Google Play"
                width="135"
                height="40"
                class="h-10 w-auto app-badge"
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
        </div>
      </div>

      <!-- Maquininhas -->
      <div>
        <h3 class="mb-5 text-[11px] font-semibold uppercase tracking-[0.2em] text-modopag-amber">
          Maquininhas
        </h3>
        <ul class="space-y-3">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  title={link.title}
                  class="text-sm text-modopag-bg/80 transition hover:text-modopag-amber"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Soluções -->
      <div>
        <h3 class="mb-5 text-[11px] font-semibold uppercase tracking-[0.2em] text-modopag-amber">
          Soluções
        </h3>
        <ul class="space-y-3">
          {
            solutionLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  title={link.title}
                  class="text-[14px] leading-snug text-white/60 transition-colors hover:text-modopag-amber"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Ajuda -->
      <div>
        <h3 class="mb-5 text-[11px] font-semibold uppercase tracking-[0.2em] text-modopag-amber">
          Ajuda
        </h3>
        <ul class="space-y-3">
          {
            helpLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  title={link.title}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-modopag-bg/80 transition hover:text-modopag-amber"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="mb-5 text-[11px] font-semibold uppercase tracking-[0.2em] text-modopag-amber">
          Legal
        </h3>
        <ul class="space-y-3">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-modopag-bg/80 transition hover:text-modopag-amber"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-12 h-px w-full bg-modopag-bg/10"></div>

    <!-- Bottom bar: Copyright + Social -->
    <div class="mt-8 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <p class="text-xs leading-relaxed text-modopag-bg/60">
        &copy; {currentYear} modoPAG &middot; CNPJ 58.172.447/0001-28
        &middot; Todos os direitos reservados.
      </p>

      <ul class="flex items-center gap-2">
        {
          social.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.name}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-modopag-bg/15 text-modopag-bg/70 transition hover:border-modopag-amber hover:bg-modopag-amber/10 hover:text-modopag-amber"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={item.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="relative h-6"></div>
</footer>

<style>
  /* App Store / Google Play badges no fundo escuro:
     invertem o preto pra branco, mantendo o texto legível. */
  .app-badge {
    filter: invert(1) brightness(1.15);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .app-badge:hover {
    opacity: 1;
  }
</style>
