---
/**
 * Header do blog — mesmo padrão do Navbar do site modopag.com.br
 * (referência: site-modopag/src/components/sections/Navbar.astro).
 * Pill flutuante sticky, dropdowns Maquininhas/Soluções do site com URL
 * absoluta + UTM, item "Blog" ativo com as categorias, CTA amber em pill.
 * Sem ícone de busca: /busca não existe no blog (ANALISE-PROJETO).
 */

const SITE_URL = 'https://modopag.com.br';
const utmNav = 'utm_source=blog&utm_medium=nav';
const utmNavCta = 'utm_source=blog&utm_medium=nav_cta';

/** URL absoluta pro site com UTM de navegação. */
const nav = (path: string) => `${SITE_URL}${path}?${utmNav}`;

interface DropdownSub {
  label: string;
  href: string;
  desc?: string;
  title?: string;
}

const maquininhaSubs: DropdownSub[] = [
  { label: 'modo Mini', href: nav('/maquininhas/modo-mini/'), title: 'modo Mini — maquininha de cartão da modoPAG' },
  { label: 'modo Pro', href: nav('/maquininhas/modo-pro/'), title: 'modo Pro — maquininha de cartão da modoPAG' },
  { label: 'modo Smart', href: nav('/maquininhas/modo-smart/'), title: 'modo Smart — maquininha de cartão da modoPAG' },
];

const solucoesSubs: DropdownSub[] = [
  { label: 'modo LINK', href: nav('/modolink/'), desc: 'Link de pagamento', title: 'modo LINK — link de pagamento da modoPAG, venda em até 18x' },
  { label: 'modo TAP', href: nav('/modo-tap/'), desc: 'Aceite no celular', title: 'modo TAP — aceite cartão direto no celular' },
  { label: 'modo VOUCHER', href: nav('/maquina-de-cartao-com-voucher/'), desc: 'Vale-refeição e alimentação', title: 'modo VOUCHER — aceite vale-refeição e alimentação na maquininha modoPAG' },
  { label: 'modo TEF', href: nav('/maquina-de-cartao-tef/'), desc: 'Integrado ao seu sistema', title: 'modo TEF — Pin Pad integrado à automação comercial, sem mensalidade' },
  { label: 'Recarga de celular', href: nav('/maquina-de-recarga-de-celular/'), desc: 'Venda na maquininha', title: 'Venda recarga de celular na maquininha modoPAG com 0% de taxa e comissão' },
  { label: 'modo RECIBO', href: nav('/modo-recibo/'), desc: 'Recibo digital com assinatura', title: 'modo RECIBO — recibo digital com assinatura jurídica' },
  { label: 'modo GESTOR', href: nav('/modo-gestor/'), desc: 'Sistema pra barbearia', title: 'modo GESTOR — sistema de gestão para barbearia' },
];

// Categorias do blog (links internos, sem UTM)
const blogSubs: DropdownSub[] = [
  { label: 'Pagamentos', href: '/pagamentos/' },
  { label: 'Negócios', href: '/negocios/' },
  { label: 'Guia do MEI', href: '/guia-do-mei/' },
  { label: 'Finanças', href: '/financas/' },
  { label: 'Calculadoras', href: '/calculadoras/' },
  { label: 'Ferramentas', href: '/ferramentas/' },
];

interface NavItem {
  label: string;
  href: string;
  title?: string;
}

const navItems: NavItem[] = [
  { label: 'Planos e Taxas', href: nav('/planos-e-taxas/'), title: 'Planos e taxas da modoPAG' },
  { label: 'Conta PJ', href: nav('/conta-digital-pj/'), title: 'Conta digital PJ da modoPAG' },
];

const ctaHref = `${SITE_URL}/maquininhas/?${utmNavCta}`;
---

<header class="sticky top-0 z-40 flex justify-center px-4 pt-4 pb-2 sm:pt-5">
  <nav
    data-nav
    aria-label="Navegação principal"
    class="flex w-full max-w-5xl items-center justify-between gap-3 rounded-full bg-modopag-bg px-3 py-2 pl-5 shadow-[0_12px_32px_-16px_rgba(17,17,17,0.18)] sm:gap-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 transition-opacity hover:opacity-90"
      aria-label="Blog modoPAG — página inicial"
    >
      <picture>
        <source type="image/avif" srcset="/images/brand/modopag-black-accent.avif" />
        <source type="image/webp" srcset="/images/brand/modopag-black-accent.webp" />
        <img
          src="/images/brand/modopag-black-accent.png"
          alt="modoPAG"
          width="176"
          height="44"
          fetchpriority="high"
          decoding="async"
          class="h-8 w-auto sm:h-10"
        />
      </picture>
      <span
        class="hidden items-center rounded-md bg-modopag-text px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.1em] text-modopag-amber sm:inline-flex"
        style="font-family: 'JetBrains Mono Variable', ui-monospace, monospace;"
      >
        Blog
      </span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      <!-- Blog (ativo) + categorias -->
      <div class="group/dropdown relative">
        <a
          href="/"
          aria-haspopup="true"
          title="Blog modoPAG — todos os artigos"
          class="flex items-center gap-1 whitespace-nowrap rounded-full bg-modopag-text/[0.05] px-2.5 py-2 text-[13px] font-semibold text-modopag-text transition-colors hover:bg-modopag-text/[0.08]"
        >
          Blog
          <svg class="h-3.5 w-3.5 text-modopag-soft transition-transform duration-200 group-hover/dropdown:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </a>

        <div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover/dropdown:pointer-events-auto group-hover/dropdown:opacity-100 group-focus-within/dropdown:pointer-events-auto group-focus-within/dropdown:opacity-100">
          <div class="min-w-[200px] rounded-2xl border border-modopag-text/8 bg-modopag-surface/95 p-1.5 shadow-[0_16px_40px_-16px_rgba(0,0,0,0.18)] backdrop-blur-md">
            {
              blogSubs.map((sub) => (
                <a
                  href={sub.href}
                  class="flex items-center justify-between rounded-xl px-3 py-2 text-[13px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
                >
                  <span>{sub.label}</span>
                </a>
              ))
            }
            <div class="my-1 h-px bg-modopag-text/5"></div>
            <a
              href="/ferramentas/"
              class="flex items-center justify-between rounded-xl px-3 py-2 text-[12px] font-medium text-modopag-muted transition-colors hover:bg-modopag-text/[0.04] hover:text-modopag-text"
            >
              <span>Todas as ferramentas grátis</span>
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Maquininhas -->
      <div class="group/dropdown relative">
        <a
          href={nav('/maquininhas/')}
          aria-haspopup="true"
          title="Maquininhas de cartão da modoPAG"
          class="flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-2 text-[13px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
        >
          Maquininhas
          <svg class="h-3.5 w-3.5 text-modopag-soft transition-transform duration-200 group-hover/dropdown:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </a>

        <div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover/dropdown:pointer-events-auto group-hover/dropdown:opacity-100 group-focus-within/dropdown:pointer-events-auto group-focus-within/dropdown:opacity-100">
          <div class="min-w-[200px] rounded-2xl border border-modopag-text/8 bg-modopag-surface/95 p-1.5 shadow-[0_16px_40px_-16px_rgba(0,0,0,0.18)] backdrop-blur-md">
            {
              maquininhaSubs.map((sub) => (
                <a
                  href={sub.href}
                  title={sub.title}
                  class="flex items-center justify-between rounded-xl px-3 py-2 text-[13px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
                >
                  <span>{sub.label}</span>
                </a>
              ))
            }
            <div class="my-1 h-px bg-modopag-text/5"></div>
            <a
              href={nav('/maquininhas/')}
              class="flex items-center justify-between rounded-xl px-3 py-2 text-[12px] font-medium text-modopag-muted transition-colors hover:bg-modopag-text/[0.04] hover:text-modopag-text"
            >
              <span>Ver todas</span>
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Soluções -->
      <div class="group/dropdown relative">
        <button
          type="button"
          aria-haspopup="true"
          aria-label="Soluções de pagamento da modoPAG"
          class="flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-2 text-[13px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
        >
          Soluções
          <svg class="h-3.5 w-3.5 text-modopag-soft transition-transform duration-200 group-hover/dropdown:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover/dropdown:pointer-events-auto group-hover/dropdown:opacity-100 group-focus-within/dropdown:pointer-events-auto group-focus-within/dropdown:opacity-100">
          <div class="min-w-[240px] rounded-2xl border border-modopag-text/8 bg-modopag-surface/95 p-1.5 shadow-[0_16px_40px_-16px_rgba(0,0,0,0.18)] backdrop-blur-md">
            {
              solucoesSubs.map((sub) => (
                <a
                  href={sub.href}
                  title={sub.title}
                  class="flex flex-col items-start gap-0.5 rounded-xl px-3 py-2.5 transition-colors hover:bg-modopag-text/[0.04]"
                >
                  <span class="text-[13px] font-medium text-modopag-text">{sub.label}</span>
                  <span class="text-[11px] text-modopag-muted">{sub.desc}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {
        navItems.map((item) => (
          <a
            href={item.href}
            title={item.title}
            class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-2 text-[13px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5">
      <a
        href="https://conta.modopag.com.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-full px-3 py-2 text-[13px] font-medium text-modopag-muted transition-colors hover:bg-modopag-text/[0.04] hover:text-modopag-text sm:flex"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          <path d="M10 17l5-5-5-5" />
          <path d="M15 12H3" />
        </svg>
        Entrar
      </a>
      <a
        href={ctaHref}
        data-no-instant
        class="btn-depth btn-depth-hover relative inline-flex select-none items-center justify-center gap-2 whitespace-nowrap rounded-full bg-modopag-amber px-5 py-2.5 text-[13px] font-medium text-modopag-text transition-colors duration-200 hover:bg-modopag-amber-accent"
      >
        Pedir maquininha
      </a>

      <!-- Botão hambúrguer mobile (< lg) -->
      <button
        type="button"
        data-mobile-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-modopag-text transition-colors hover:bg-modopag-text/[0.04] lg:hidden"
      >
        <svg data-icon-open class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg data-icon-close class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menu mobile (drawer abaixo do pill) -->
  <div
    id="mobile-menu"
    data-mobile-menu
    class="pointer-events-none fixed inset-x-0 top-[84px] z-30 mx-4 max-h-[calc(100vh-110px)] max-w-5xl translate-y-2 overflow-y-auto rounded-3xl border border-modopag-text/8 bg-modopag-surface/95 p-2 opacity-0 shadow-[0_20px_50px_-16px_rgba(0,0,0,0.2)] backdrop-blur-md transition-all duration-200 sm:left-1/2 sm:mx-auto sm:top-[92px] sm:-translate-x-1/2 lg:hidden"
  >
    <nav class="flex flex-col p-2" aria-label="Menu mobile">
      <p class="px-3 pb-1 pt-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-modopag-amber-deep">
        Blog
      </p>
      {
        blogSubs.map((sub) => (
          <a
            href={sub.href}
            class="flex items-center justify-between rounded-xl px-3 py-2.5 text-[14px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
          >
            <span>{sub.label}</span>
          </a>
        ))
      }
      <a
        href="/ferramentas/"
        class="flex items-center justify-between rounded-xl px-3 py-2 text-[12px] font-medium text-modopag-muted transition-colors hover:bg-modopag-text/[0.04] hover:text-modopag-text"
      >
        <span>Todas as ferramentas grátis</span>
      </a>

      <div class="my-2 h-px bg-modopag-text/5"></div>

      <p class="px-3 pb-1 pt-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-modopag-amber-deep">
        Maquininhas
      </p>
      {
        maquininhaSubs.map((sub) => (
          <a
            href={sub.href}
            title={sub.title}
            class="flex items-center justify-between rounded-xl px-3 py-2.5 text-[14px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
          >
            <span>{sub.label}</span>
          </a>
        ))
      }
      <a
        href={nav('/maquininhas/')}
        class="flex items-center justify-between rounded-xl px-3 py-2 text-[12px] font-medium text-modopag-muted transition-colors hover:bg-modopag-text/[0.04] hover:text-modopag-text"
      >
        <span>Ver todas</span>
      </a>

      <div class="my-2 h-px bg-modopag-text/5"></div>

      <p class="px-3 pb-1 pt-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-modopag-amber-deep">
        Soluções
      </p>
      {
        solucoesSubs.map((sub) => (
          <a
            href={sub.href}
            title={sub.title}
            class="flex flex-col items-start rounded-xl px-3 py-2 transition-colors hover:bg-modopag-text/[0.04]"
          >
            <span class="text-[14px] font-medium text-modopag-text">{sub.label}</span>
            <span class="text-[11px] text-modopag-muted">{sub.desc}</span>
          </a>
        ))
      }

      <div class="my-2 h-px bg-modopag-text/5"></div>

      {
        navItems.map((item) => (
          <a
            href={item.href}
            title={item.title}
            class="flex items-center gap-1.5 rounded-xl px-3 py-2.5 text-[14px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
          >
            {item.label}
          </a>
        ))
      }

      <div class="my-2 h-px bg-modopag-text/5"></div>

      <a
        href="https://conta.modopag.com.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-[14px] font-medium text-modopag-text transition-colors hover:bg-modopag-text/[0.04]"
      >
        <svg class="h-4 w-4 text-modopag-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          <path d="M10 17l5-5-5-5" />
          <path d="M15 12H3" />
        </svg>
        Entrar
      </a>
    </nav>
  </div>
</header>

<style>
  /* Pill do nav — borda sutil, mesmo padrão do [data-nav] do site */
  [data-nav] {
    border: 1px solid rgba(17, 17, 17, 0.05);
  }
</style>

<script>
  // Menu mobile — mesmo padrão do site: re-init em astro:page-load
  // (ViewTransitions não re-executa módulos em navegação SPA) e
  // AbortController pra limpar listeners da página anterior.
  let menuAbortController: AbortController | null = null;

  const initMobileMenu = () => {
    menuAbortController?.abort();
    menuAbortController = new AbortController();
    const signal = menuAbortController.signal;

    const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (!toggle || !menu) return;

    const open = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Fechar menu');
      toggle.querySelector<SVGElement>('[data-icon-open]')?.classList.add('hidden');
      toggle.querySelector<SVGElement>('[data-icon-close]')?.classList.remove('hidden');
      menu.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-2');
      menu.classList.add('opacity-100', 'translate-y-0');
    };

    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menu');
      toggle.querySelector<SVGElement>('[data-icon-open]')?.classList.remove('hidden');
      toggle.querySelector<SVGElement>('[data-icon-close]')?.classList.add('hidden');
      menu.classList.add('pointer-events-none', 'opacity-0', 'translate-y-2');
      menu.classList.remove('opacity-100', 'translate-y-0');
    };

    toggle.addEventListener(
      'click',
      () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        isOpen ? close() : open();
      },
      { signal }
    );

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => close(), { signal });
    });

    document.addEventListener(
      'click',
      (e) => {
        const target = e.target as Node;
        if (
          toggle.getAttribute('aria-expanded') === 'true' &&
          !menu.contains(target) &&
          !toggle.contains(target)
        ) {
          close();
        }
      },
      { signal }
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') close();
      },
      { signal }
    );
  };

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
