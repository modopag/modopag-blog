---
/**
 * TLDRBlock.astro — Resumo editorial premium
 *
 * Bloco de resumo otimizado pra citação por LLMs (GEO).
 * Visual inspirado no estilo modogestor: paper sobre cream com border-left
 * gold, label mono uppercase tracking, content em Fraunces serif pra um
 * toque editorial.
 *
 * Recomendação: 50-60 palavras, resposta direta e autocontida.
 *
 * Uso com prop:
 *   <TLDRBlock text="MEIs devem priorizar maquininhas..." />
 *
 * Uso com slot:
 *   <TLDRBlock>
 *     MEIs devem priorizar maquininhas com taxa abaixo de 1,5%...
 *   </TLDRBlock>
 */

interface Props {
  text?: string;
  label?: string;
}

const { text, label = 'Resumo' } = Astro.props;
---

<aside class="tldr" role="note" aria-label="Resumo do artigo">
  <span class="tldr__label">
    <span class="tldr__dot" aria-hidden="true"></span>
    {label}
  </span>
  <p class="tldr__content">
    {text ? text : <slot />}
  </p>
</aside>

<style>
  .tldr {
    position: relative;
    margin: 1.5rem 0 2.5rem;
    padding: 1.5rem 1.75rem;
    background: theme('colors.cream.paper');
    border: 1px solid theme('colors.line.DEFAULT');
    border-left: 3px solid theme('colors.gold.DEFAULT');
    border-radius: 0.875rem;
    box-shadow: var(--shadow-sm);
  }

  .tldr__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono Variable', ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    color: theme('colors.gold.deep');
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 0.875rem;
  }

  .tldr__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: theme('colors.gold.DEFAULT');
    box-shadow: 0 0 0 3px rgba(245, 200, 66, 0.18);
  }

  .tldr__content {
    margin: 0;
    font-family: 'Fraunces', ui-serif, Georgia, serif;
    font-feature-settings: 'ss01', 'ss03';
    font-optical-sizing: auto;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: theme('colors.ink.DEFAULT');
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* Conserva espaços/linhas se o texto vier multilinha do CMS */
  .tldr__content {
    white-space: pre-wrap;
  }

  @media (max-width: 640px) {
    .tldr {
      padding: 1.25rem 1.25rem;
      margin: 1.25rem 0 2rem;
    }
    .tldr__content {
      font-size: 1rem;
    }
  }
</style>
